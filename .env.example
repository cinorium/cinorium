# ==============================================================================
# Cinorium Contact Form Email Delivery Configuration
# ==============================================================================
# To enable contact form email delivery, configure your Gmail account with an
# App Password (generated at https://myaccount.google.com/apppasswords).
#
# Copy this file to .env.local and populate the values below.
# Never commit real credentials to version control.
# ==============================================================================

# Gmail SMTP Sender Account (your full Gmail address)
GMAIL_USER=

# Gmail 16-character App Password (e.g. abcd efgh ijkl mnop)
GMAIL_APP_PASSWORD=

# Destination email address where enquiries are delivered
# (Defaults to cinoriumadmin@gmail.com if omitted)
CONTACT_TO_EMAIL=

# Legacy environment variable support (optional aliases)
# EMAIL_USER=
# EMAIL_PASS=

# ==============================================================================
# Cinorium Signals — Lead Capture & Admin CRM Configuration
# ==============================================================================
# Passphrase to log into the private admin dashboard at /admin/signals
SIGNALS_ADMIN_PASSWORD=cinorium2026

# Random 32+ character secret key for HMAC-SHA256 session cookie signing
SIGNALS_SESSION_SECRET=change_this_to_a_random_secure_secret_string_32_chars

# Supabase PostgreSQL Storage (Optional — if omitted, local storage is used)
# Provide these when deploying to production with Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
