# ==============================================================================
# Cinorium Contact Form Email Delivery Configuration
# ==============================================================================
# To enable contact form email delivery, configure your Gmail account with an
# App Password (generated at https://myaccount.google.com/apppasswords).
#
# Copy this file to .env.local and populate the values below.
# Never commit real credentials to version control.
# ==============================================================================

# Gmail SMTP Sender Account (your full Gmail address)
GMAIL_USER=

# Gmail 16-character App Password (e.g. abcd efgh ijkl mnop)
GMAIL_APP_PASSWORD=

# Destination email address where enquiries are delivered
# (Defaults to cinoriumadmin@gmail.com if omitted)
CONTACT_TO_EMAIL=

# Legacy environment variable support (optional aliases)
# EMAIL_USER=
# EMAIL_PASS=
